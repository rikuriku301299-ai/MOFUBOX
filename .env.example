# Copy this file to .env and fill in the values you need.
# MOFUBOX's server (server/index.js) only reads real environment variables
# (process.env.*) -- it does not load .env files automatically. Export these
# yourself, use your host's "environment variables" UI, or run with a tool
# like `dotenv`/`env $(cat .env | xargs)` if you want file-based loading.

# --- Server ---
# Port the HTTP server listens on.
PORT=8910

# --- Database & uploads ---
# Where the SQLite database file is created. Defaults to ./data/mofubox.sqlite3
MOFUBOX_DB_PATH=./data/mofubox.sqlite3
# Where uploaded reel videos are stored. Defaults to ./data/uploads
MOFUBOX_UPLOADS_DIR=./data/uploads

# --- Initial admin account ---
# Used only the very first time the server boots against an empty database
# (server/seed.js). Change these before your first production boot.
MOFUBOX_ADMIN_EMAIL=admin@mofubox.jp
MOFUBOX_ADMIN_PASSWORD=rikuto1289

# --- Cookies ---
# Set to "1" once you're serving over HTTPS so session cookies get the
# Secure flag. Leave unset for local HTTP development.
COOKIE_SECURE=

# --- Stripe (optional) ---
# Leave both unset to run with payments disabled -- the checkout endpoint
# responds with a clean 501 "stripe_not_configured" instead of erroring.
# Fill these in with real keys from your Stripe dashboard to enable payments.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
